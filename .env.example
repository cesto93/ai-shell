# Copy to .env and fill in. .env is loaded at startup via gotenv.

# Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=

# OpenRouter
OPEN_ROUTE_KEY=

# Ollama (defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# LiteRT-LM (in-process provider)
# Directory containing the LiteRT-LM shared libs (default ~/.ai-shell/lib)
LITERTLM_LIB=
# Path to a .litertlm model (default: scan LITERTLM_MODELS_DIR)
LITERTLM_MODEL=
# Directory scanned for .litertlm models (default ~/.ai-shell/models/litertlm/)
LITERTLM_MODELS_DIR=
# Backend: cpu or gpu (default cpu)
LITERTLM_BACKEND=cpu

# llamacpp (in-process provider)
# Vision projector GGUF for image input (path or filename in ~/.ai-shell/models/llamacpp/).
# Default: scan the llamacpp models dir for a *mmproj*.gguf file.
LLAMACPP_MMPROJ=
