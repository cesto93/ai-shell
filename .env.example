# Copy to .env and fill in. .env is loaded at startup via gotenv.

# Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=

# OpenRouter
OPEN_ROUTE_KEY=

# Ollama (defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# LiteRT-LM (in-process provider)
# Directory containing the LiteRT-LM shared libs (default ~/.ai-shell/lib)
LITERTLM_LIB=
# Backend: cpu or gpu (default cpu)
LITERTLM_BACKEND=cpu

# Telegram bot (ai-shell bot)
# Create a bot via @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=
# Optional: comma-separated allowlist of chat IDs or @usernames (empty = allow everyone)
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,@myuser

# llamacpp (in-process provider)
# Vision projector (mmproj) GGUF is auto-detected by scanning
# ~/.ai-shell/models/llamacpp/ for a *mmproj*.gguf file.
